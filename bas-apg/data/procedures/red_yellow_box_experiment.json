{
  "id": "red_yellow_box_v1",
  "name": "Red/Yellow Box Sample Transfer",
  "version": "1.0",
  "description": "Simulated BAS experiment: transfer sample between colored containers. NOT an actual ISRO/BAS procedure.",
  "objects": ["main_box", "red_box", "yellow_box", "sample", "tweezers"],
  "steps": [
    {
      "step_id": "S01",
      "action": "PICK",
      "object": "main_box",
      "description": "Pick up the main experiment container from the work surface.",
      "timeout_seconds": 30,
      "next_step": "S02",
      "required_evidence": ["hand_contact", "object_movement"],
      "confidence_threshold": 0.85,
      "recovery_options": ["voice_prompt", "highlight_object"]
    },
    {
      "step_id": "S02",
      "action": "OPEN",
      "object": "main_box",
      "description": "Open the lid of the main container.",
      "timeout_seconds": 45,
      "next_step": "S03",
      "required_evidence": ["hand_interaction", "lid_state_change"],
      "confidence_threshold": 0.80,
      "recovery_options": ["voice_prompt"]
    },
    {
      "step_id": "S03",
      "action": "PICK",
      "object": "sample",
      "description": "Pick up the sample from inside the main container.",
      "timeout_seconds": 30,
      "next_step": "S04",
      "required_evidence": ["hand_contact", "object_movement"],
      "confidence_threshold": 0.85,
      "recovery_options": ["voice_prompt"]
    },
    {
      "step_id": "S04",
      "action": "TRANSFER",
      "object": "sample",
      "description": "Transfer the sample to the red box.",
      "timeout_seconds": 60,
      "next_step": "S05",
      "required_evidence": ["continuous_tracking", "spatial_translation"],
      "confidence_threshold": 0.75,
      "recovery_options": ["voice_prompt", "check_dropped"]
    },
    {
      "step_id": "S05",
      "action": "CLOSE",
      "object": "red_box",
      "description": "Close the red box after sample is placed inside.",
      "timeout_seconds": 30,
      "next_step": "S06",
      "required_evidence": ["hand_interaction"],
      "confidence_threshold": 0.80,
      "recovery_options": ["voice_prompt"]
    },
    {
      "step_id": "S06",
      "action": "CLOSE",
      "object": "main_box",
      "description": "Close the main container lid.",
      "timeout_seconds": 45,
      "next_step": null,
      "required_evidence": ["hand_interaction"],
      "confidence_threshold": 0.80,
      "recovery_options": ["voice_prompt"]
    }
  ]
}
